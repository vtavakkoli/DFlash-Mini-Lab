FROM python:3.11-slim-bookworm

ARG EAGLE_COMMIT=cb7e0841fe0c206c6ed74a197ad5e2a1f13f5a2b

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    TOKENIZERS_PARALLELISM=false \
    HF_HUB_DISABLE_TELEMETRY=1 \
    CPU_THREADS=2 \
    OMP_NUM_THREADS=2 \
    MKL_NUM_THREADS=2 \
    OPENBLAS_NUM_THREADS=2

WORKDIR /app

RUN apt-get update \
 && apt-get install -y --no-install-recommends git ca-certificates \
 && rm -rf /var/lib/apt/lists/*

RUN python -m pip install --upgrade pip \
 && python -m pip install torch==2.6.0 --index-url https://download.pytorch.org/whl/cpu \
 && python -m pip install \
      transformers==4.53.3 \
      accelerate==0.26.0 \
      sentencepiece==0.1.99 \
      safetensors>=0.4.3 \
      huggingface-hub>=0.30.0 \
      protobuf>=4.25.0

RUN git clone --filter=blob:none https://github.com/SafeAILab/EAGLE.git /opt/EAGLE \
 && cd /opt/EAGLE \
 && git checkout "$EAGLE_COMMIT" \
 && git rev-parse HEAD

ENV PYTHONPATH=/opt/EAGLE:/app/src

COPY src ./src
COPY qwen_benchmarks ./qwen_benchmarks

RUN python -m py_compile src/dflash_mini_lab/eagle3_v8.py \
 && mkdir -p /cache /app/eagle3-reports

ENTRYPOINT ["python", "-m", "dflash_mini_lab.eagle3_v8"]
