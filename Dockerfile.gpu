FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    TOKENIZERS_PARALLELISM=false \
    HF_HOME=/cache \
    CPU_THREADS=4 \
    OMP_NUM_THREADS=4 \
    MKL_NUM_THREADS=4 \
    OPENBLAS_NUM_THREADS=4 \
    LFM_GPU_DTYPE=float16 \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility

WORKDIR /app

RUN python -m pip install --upgrade pip \
 && python -m pip install torch torchvision --index-url https://download.pytorch.org/whl/cu132 \
 && python -m pip install numpy transformers

COPY src ./src
COPY real_benchmarks ./real_benchmarks
COPY scripts ./scripts
COPY run_gpu.py ./run_gpu.py
RUN chmod +x /app/scripts/test_gpu.sh

RUN mkdir -p /cache /app/lfm-artifacts /app/gpu-reports

CMD ["/app/scripts/test_gpu.sh"]
