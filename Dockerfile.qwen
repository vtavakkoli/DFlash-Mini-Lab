FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    TOKENIZERS_PARALLELISM=false \
    HF_HOME=/cache \
    CPU_THREADS=2 \
    OMP_NUM_THREADS=2 \
    MKL_NUM_THREADS=2 \
    OPENBLAS_NUM_THREADS=2

WORKDIR /app

RUN python -m pip install --upgrade pip \
 && python -m pip install torch==2.10.0 --index-url https://download.pytorch.org/whl/cpu \
 && python -m pip install transformers==5.16.1 huggingface-hub==0.35.1 safetensors==0.6.2

COPY pyproject.toml README.md LICENSE requirements.txt ./
COPY src ./src
COPY qwen_benchmarks ./qwen_benchmarks
RUN python -m pip install . \
 && python -m py_compile \
      src/dflash_mini_lab/qwen_aux.py \
      src/dflash_mini_lab/qwen_prepare.py \
      src/dflash_mini_lab/qwen_runtime.py \
      src/dflash_mini_lab/qwen_benchmark.py \
      src/dflash_mini_lab/qwen_cli.py

RUN mkdir -p /cache /app/qwen-artifacts /app/qwen-reports

CMD ["python", "-m", "dflash_mini_lab.qwen_cli", "--output-dir", "/app/qwen-reports"]
